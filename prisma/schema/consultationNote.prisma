model ConsultationNote {
  id           String   @id @default(uuid(7))
  followUpDate DateTime?
  notes        String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([appointmentId])
  @@index([clientId])
  @@index([lawyerId])
  @@map("consultation_notes")
}