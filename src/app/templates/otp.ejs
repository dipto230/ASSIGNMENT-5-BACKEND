<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>OTP Verification</title>
</head>
<body style="margin:0; padding:0; background:#f4f6f8; font-family: Arial, sans-serif;">

  <table width="100%" cellspacing="0" cellpadding="0" style="padding: 40px 0;">
    <tr>
      <td align="center">

        <!-- Card -->
        <table width="400" cellspacing="0" cellpadding="0" 
          style="background:#ffffff; border-radius:12px; padding:30px; box-shadow:0 4px 15px rgba(0,0,0,0.08); text-align:center;">
          
          <!-- Title -->
          <tr>
            <td>
              <h2 style="color:#333; margin-bottom:10px;">
                Hello <%= name %> 👋
              </h2>
              <p style="color:#777; font-size:14px; margin-bottom:20px;">
                Use the OTP below to verify your account
              </p>
            </td>
          </tr>

          <!-- OTP Box -->
          <tr>
            <td>
              <div style="
                display:inline-block;
                background:#f1f5ff;
                color:#4f46e5;
                font-size:28px;
                font-weight:bold;
                letter-spacing:6px;
                padding:15px 25px;
                border-radius:8px;
                margin:20px 0;
              ">
                <%= otp %>
              </div>
            </td>
          </tr>

          <!-- Info -->
          <tr>
            <td>
              <p style="color:#555; font-size:14px; margin-top:10px;">
                This OTP will expire in <b>2 minutes</b>.
              </p>

              <p style="color:#999; font-size:12px; margin-top:20px;">
                If you didn’t request this, you can safely ignore this email.
              </p>
            </td>
          </tr>

        </table>

        <!-- Footer -->
        <p style="margin-top:20px; font-size:12px; color:#aaa;">
          © 2026 Your App. All rights reserved.
        </p>

      </td>
    </tr>
  </table>

</body>
</html>